# Supabase Configuration
SUPABASE_URL=https://lgmwolyyeexhpaisihen.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_side_service_role_key
# Alternative accepted key names:
# SUPABASE_SERVICE_KEY=your_server_side_service_role_key

# Optional: Custom contact table name (defaults to 'contacts')
CONTACT_TABLE=contacts

# Application update signups use a separate Supabase table.
NOTIFICATION_TABLE=application_notifications

# Cloudflare Turnstile. Site key is public; secret key must remain server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Optional: Server port (defaults to 3000)
PORT=3000
